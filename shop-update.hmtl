<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Mooni Mani | Press-On Nails</title>

<style>

/* GENERAL */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #FFF9F7;
    color: #594B50;
}

/* HEADER */

header {
    background: #FCE9EE;
    text-align: center;
    padding: 35px 20px;
}

.logo {
    font-size: 38px;
    font-weight: bold;
    color: #A66B7B;
    letter-spacing: 2px;
}

.tagline {
    color: #987B85;
    font-size: 14px;
    margin-top: 12px;
}

/* NAVIGATION */

nav {
    margin-top: 25px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
}

nav a {
    text-decoration: none;
    color: #805E69;
    font-size: 15px;
    font-weight: 500;
    transition: color 0.3s;
}

nav a:hover {
    color: #C98FA1;
}

/* HERO */

.hero {
    text-align: center;
    padding: 70px 20px;
}

.hero h1 {
    color: #A66B7B;
    font-size: 38px;
    margin-bottom: 15px;
}

.hero p {
    color: #987B85;
    font-size: 16px;
    line-height: 1.8;
}

/* SHOP SECTION */

.shop {
    max-width: 1200px;
    margin: auto;
    padding: 30px 20px 80px;
}

.shop h2 {
    text-align: center;
    color: #A66B7B;
    font-size: 30px;
    margin-bottom: 15px;
}

.shop-description {
    text-align: center;
    color: #987B85;
    margin-bottom: 45px;
}

/* PRODUCT GRID */

.product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

/* PRODUCT CARDS */

.product-card {
    background: white;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
}

.product-card:hover {
    transform: translateY(-5px);
}

/* PRODUCT IMAGE PLACEHOLDER */

.product-image {
    width: 100%;
    height: 260px;
    background: #F9E7EB;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #B88A98;
    font-size: 15px;
    text-align: center;
    padding: 20px;
}

/* PRODUCT INFORMATION */

.product-info {
    padding: 22px;
    text-align: center;
}

.product-info h3 {
    color: #805E69;
    font-size: 18px;
    margin-bottom: 10px;
}

.price {
    font-size: 17px;
    color: #A66B7B;
    font-weight: bold;
    margin-bottom: 18px;
}

/* SIZE SELECTOR */

.size-select {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
    border: 1px solid #E9D7DD;
    border-radius: 8px;
    background: white;
    color: #594B50;
    font-size: 14px;
}

/* ADD TO CART BUTTON */

.product-button {
    width: 100%;
    background: #C98FA1;
    color: white;
    padding: 13px;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    cursor: pointer;
    transition: background 0.3s;
}

.product-button:hover {
    background: #B77B8D;
}

/* SHOPPING CART */

.cart-section {
    max-width: 850px;
    margin: 0 auto 80px;
    padding: 35px;
    background: white;
    border-radius: 20px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
}

.cart-section h2 {
    text-align: center;
    color: #A66B7B;
    margin-bottom: 30px;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid #F1E5E9;
    gap: 15px;
}

.cart-details {
    flex: 1;
}

.cart-details strong {
    color: #805E69;
}

.cart-details p {
    font-size: 13px;
    color: #987B85;
}

/* QUANTITY CONTROLS */

.cart-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}

.cart-controls button {
    background: #FCE9EE;
    color: #805E69;
    border: none;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
}

.cart-controls button:hover {
    background: #F5D5DE;
}

.cart-total {
    text-align: right;
    font-size: 20px;
    font-weight: bold;
    color: #A66B7B;
    margin-top: 25px;
}

.cart-note {
    text-align: center;
    font-size: 13px;
    color: #987B85;
    margin-top: 20px;
}

/* CHECKOUT BUTTON */

.checkout-button {
    display: block;
    width: 100%;
    margin-top: 25px;
    padding: 15px;
    background: #C98FA1;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
}

.checkout-button:disabled {
    background: #D9C9CE;
    cursor: not-allowed;
}

/* FOOTER */

footer {
    background: #FCE9EE;
    text-align: center;
    padding: 35px 20px;
    color: #987B85;
    font-size: 13px;
    line-height: 2;
}

/* MOBILE DESIGN */

@media (max-width: 900px) {

    .product-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 600px) {

    .product-grid {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 28px;
    }

    .logo {
        font-size: 30px;
    }

    nav {
        gap: 15px;
    }

    nav a {
        font-size: 13px;
    }

    .cart-section {
        margin: 20px;
        padding: 22px;
    }

    .cart-item {
        flex-direction: column;
        align-items: flex-start;
    }

}

</style>

</head>

<body>

<!-- HEADER -->

<header>

    <div class="logo">
        ☾ Mooni Mani
    </div>

    <p class="tagline">
        A little moonlight at your fingertips ✨
    </p>

    <!-- NAVIGATION MENU -->

    <nav>

        <a href="index.html">Home</a>

        <a href="index.html#shop">Shop</a>

        <a href="faq.html">FAQ</a>

        <a href="contact.html">Contact</a>

        <a href="index.html#cart">
            🛒 Cart (<span id="cart-count">0</span>)
        </a>

    </nav>

</header>


<!-- HERO SECTION -->

<section class="hero">

    <h1>
        Pretty Nails, Made Easy ♡
    </h1>

    <p>
        Discover your next favorite press-on nail set.
        <br>
        Cute, affordable nails for every occasion.
    </p>

</section>


<!-- SHOP SECTION -->

<section class="shop" id="shop">

    <h2>
        Shop Our Nails 🌙
    </h2>

    <p class="shop-description">
        Find your perfect Mooni Mani set ♡
    </p>

    <!-- FIVE PRODUCTS APPEAR HERE -->

    <div class="product-grid" id="product-grid"></div>

</section>


<!-- SHOPPING CART SECTION -->

<section class="cart-section" id="cart">

    <h2>
        🛍️ Your Shopping Cart
    </h2>

    <div id="cart-items">
        Your cart is empty ♡
    </div>

    <div class="cart-total">

        Subtotal:
        $<span id="cart-total">0.00</span>

    </div>

    <p class="cart-note">
        Shipping and taxes are calculated at checkout.
        <br>
        Online checkout is not available yet.
    </p>

    <button class="checkout-button" disabled>
        Checkout Coming Soon ♡
    </button>

</section>


<!-- FOOTER -->

<footer>

    © 2026 Mooni Mani ♡

    <br>

    Made with love & a little moonlight.

    <br>

    <a href="faq.html" style="color:#805E69;">
        FAQ
    </a>

    &nbsp; | &nbsp;

    <a href="contact.html" style="color:#805E69;">
        Contact Us
    </a>

</footer>


<!-- JAVASCRIPT -->

<script>

/* PRODUCT INFORMATION */

const products = [

    {
        id: 1,
        name: "Moonlight Collection",
        price: 12.00
    },

    {
        id: 2,
        name: "Blush Collection",
        price: 12.00
    },

    {
        id: 3,
        name: "French Tip Collection",
        price: 12.00
    },

    {
        id: 4,
        name: "Sweetheart Collection",
        price: 12.00
    },

    {
        id: 5,
        name: "Celestial Collection",
        price: 12.00
    }

];


/* LOAD SAVED CART */

let cart = [];

try {

    const savedCart = JSON.parse(
        localStorage.getItem("moonimani-cart")
    );

    if (Array.isArray(savedCart)) {

        cart = savedCart.filter(item =>
            products.some(product => product.id === item.id) &&
            ["XS", "S", "M", "L"].includes(item.size) &&
            Number.isInteger(item.quantity) &&
            item.quantity > 0
        );

    }

} catch (error) {

    cart = [];

}


/* DISPLAY FIVE PRODUCTS */

function displayProducts() {

    const grid = document.getElementById("product-grid");

    grid.innerHTML = "";

    products.forEach(product => {

        const card = document.createElement("div");

        card.className = "product-card";

        card.innerHTML = `

            <div class="product-image">

                ♡ Product Photo Coming Soon

            </div>

            <div class="product-info">

                <h3>${product.name}</h3>

                <p class="price">
                    $${product.price.toFixed(2)}
                </p>

                <select
                    class="size-select"
                    id="size-${product.id}"
                    aria-label="Choose size for ${product.name}"
                >

                    <option value="">
                        Select Size
                    </option>

                    <option value="XS">XS</option>
                    <option value="S">S</option>
                    <option value="M">M</option>
                    <option value="L">L</option>

                </select>

                <button
                    class="product-button"
                    onclick="addToCart(${product.id})"
                >

                    Add to Cart ♡

                </button>

            </div>

        `;

        grid.appendChild(card);

    });

}


/* ADD PRODUCT TO CART */

function addToCart(productId) {

    const product = products.find(
        item => item.id === productId
    );

    const size = document.getElementById(
        `size-${productId}`
    ).value;

    if (!size) {

        alert("Please select your nail size first ♡");

        return;

    }

    const existingItem = cart.find(
        item =>
            item.id === productId &&
            item.size === size
    );

    if (existingItem) {

        existingItem.quantity += 1;

    } else {

        cart.push({

            id: product.id,
            size: size,
            quantity: 1

        });

    }

    saveCart();

    displayCart();

    alert(
        `${product.name} (${size}) added to cart! ♡`
    );

}


/* SAVE CART */

function saveCart() {

    localStorage.setItem(
        "moonimani-cart",
        JSON.stringify(cart)
    );

}


/* CHANGE QUANTITY */

function changeQuantity(index, amount) {

    cart[index].quantity += amount;

    if (cart[index].quantity <= 0) {

        cart.splice(index, 1);

    }

    saveCart();

    displayCart();

}


/* REMOVE PRODUCT */

function removeItem(index) {

    cart.splice(index, 1);

    saveCart();

    displayCart();

}


/* DISPLAY SHOPPING CART */

function displayCart() {

    const cartItems = document.getElementById("cart-items");

    const cartCount = document.getElementById("cart-count");

    const cartTotal = document.getElementById("cart-total");

    cartItems.innerHTML = "";

    let total = 0;

    let count = 0;

    if (cart.length === 0) {

        cartItems.textContent = "Your cart is empty ♡";

    } else {

        cart.forEach((item, index) => {

            const product = products.find(
                product => product.id === item.id
            );

            if (!product) return;

            const itemTotal =
                product.price * item.quantity;

            total += itemTotal;

            count += item.quantity;

            const row = document.createElement("div");

            row.className = "cart-item";

            const details = document.createElement("div");

            details.className = "cart-details";

            const name = document.createElement("strong");

            name.textContent = product.name;

            const description = document.createElement("p");

            description.textContent =
                `Size: ${item.size} | $${product.price.toFixed(2)} each`;

            details.appendChild(name);

            details.appendChild(description);

            const controls = document.createElement("div");

            controls.className = "cart-controls";

            const minus = document.createElement("button");

            minus.textContent = "−";

            minus.setAttribute(
                "aria-label",
                "Decrease quantity"
            );

            minus.onclick = () =>
                changeQuantity(index, -1);

            const quantity = document.createElement("span");

            quantity.textContent = ` ${item.quantity} `;

            const plus = document.createElement("button");

            plus.textContent = "+";

            plus.setAttribute(
                "aria-label",
                "Increase quantity"
            );

            plus.onclick = () =>
                changeQuantity(index, 1);

            const remove = document.createElement("button");

            remove.textContent = "Remove";

            remove.onclick = () =>
                removeItem(index);

            const price = document.createElement("div");

            price.textContent =
                `$${itemTotal.toFixed(2)}`;

            controls.append(
                minus,
                quantity,
                plus,
                remove,
                price
            );

            row.append(details, controls);

            cartItems.appendChild(row);

        });

    }

    cartCount.textContent = count;

    cartTotal.textContent = total.toFixed(2);

}


/* START WEBSITE */

displayProducts();

displayCart();

</script>

</body>
</html>
